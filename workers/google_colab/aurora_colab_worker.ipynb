"""
AURORA Colab Worker — Bootstrap Script
=======================================
Run this in a Google Colab notebook with GPU runtime.

Steps:
1. Open this notebook in Google Colab
2. Set Runtime → Change runtime type → GPU
3. Set AURORA_BACKEND_URL and AURORA_WORKER_TOKEN below
4. Run All (Runtime → Run all)

The worker will connect to your AURORA backend and start accepting GPU jobs.
"""

# ============================================================
# CONFIGURE THESE VALUES
# ============================================================

AURORA_BACKEND_URL = "https://your-aurora-backend.onrender.com"  # <-- Your backend URL
AURORA_WORKER_TOKEN = "your-secret-token-here"  # <-- Must match AURORA_COMPUTE_WORKER_TOKEN

# ============================================================
# SETUP — Run this cell first
# ============================================================

import subprocess
import sys

# Install dependencies
subprocess.check_call([sys.executable, "-m", "pip", "install", "-q", "requests", "torch", "--index-url", "https://download.pytorch.org/whl/cu121"])

print("Dependencies installed.")

# ============================================================
# GPU DETECTION — Verify GPU is available
# ============================================================

import torch

if torch.cuda.is_available():
    gpu_name = torch.cuda.get_device_name(0)
    vram = torch.cuda.get_device_properties(0).total_mem / (1024**3)
    print(f"GPU detected: {gpu_name}")
    print(f"VRAM: {vram:.1f} GB")
    print(f"CUDA version: {torch.version.cuda}")
    print(f"Compute capability: {'.'.join(str(x) for x in torch.cuda.get_device_capability(0))}")
else:
    print("WARNING: No GPU detected. Please set Runtime → Change runtime type → GPU.")
    print("The worker will still connect but will not have GPU capabilities.")

# ============================================================
# CONNECT WORKER — Connect to AURORA backend
# ============================================================

import hashlib
import socket
import time
import sys
import os

sys.path.insert(0, "/content/aurora-core/workers/google_colab" if os.path.exists("/content/aurora-core") else ".")

from worker import AuroraColabWorker

print(f"Connecting to AURORA backend: {AURORA_BACKEND_URL}")

worker = AuroraColabWorker(
    backend_url=AURORA_BACKEND_URL,
    worker_token=AURORA_WORKER_TOKEN,
)

if worker.connect():
    print(f"Connected! Worker ID: {worker.worker_id}")
    print("GPU capabilities reported to AURORA backend.")
    print("")
    print("The worker is now READY. You can close this notebook or keep it running.")
    print("The worker will send heartbeats every 30 seconds.")
    print("To stop the worker, interrupt the kernel or close the notebook.")
else:
    print("FAILED to connect. Check your backend URL and worker token.")
    print("Make sure AURORA_COMPUTE_WORKER_TOKEN is set on your backend.")

# ============================================================
# RUN WORKER — Blocks until disconnected
# ============================================================

# Uncomment the line below to keep the worker running:
# worker.run()
