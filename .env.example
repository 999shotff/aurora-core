# AURORA CORE — Environment Variables
# Copy to .env and fill in values. Never commit .env with secrets.

# ============================================================
# Data Provider
# ============================================================
# Data mode: "demo" (mock data) or "real" (yfinance live data)
AURORA_DATA_MODE=demo

# Yahoo Finance API key (optional for yfinance, used for authenticated access)
AURORA_YAHOO_API_KEY=

# ============================================================
# Backend Server
# ============================================================
AURORA_HOST=0.0.0.0
AURORA_PORT=8000
AURORA_DEBUG=false
AURORA_LOG_LEVEL=info

# Production CORS origins (comma-separated)
# Example: https://aurora-core.vercel.app,https://aurora-core.example.com
AURORA_CORS_ORIGINS=https://aurora-core.vercel.app

# ============================================================
# Cache
# ============================================================
AURORA_CACHE_TTL_SECONDS=60
AURORA_CACHE_MAX_SIZE=256

# ============================================================
# Rate Limiting
# ============================================================
AURORA_RATE_LIMIT_RPM=60
AURORA_RATE_LIMIT_BURST=10

# ============================================================
# WebSocket
# ============================================================
AURORA_WS_ENABLED=true
AURORA_WS_MAX_CONNECTIONS=100
AURORA_WS_PING_INTERVAL=30

# ============================================================
# Provider Timeout
# ============================================================
AURORA_PROVIDER_TIMEOUT_SECONDS=10
AURORA_PROVIDER_MAX_RETRIES=3

# ============================================================
# LLM Provider (LLM-1 Reasoning Core)
# ============================================================
# Provider name: "stub" (default, no LLM), "openai", "ollama", "openai-compatible"
AURORA_LLM_PROVIDER=stub

# API key for external providers (NEVER commit .env with secrets)
AURORA_LLM_API_KEY=

# Base URL for OpenAI-compatible APIs
AURORA_LLM_BASE_URL=https://api.openai.com/v1

# Model name (for ollama provider: qwen2.5-0.5b-ollama)
AURORA_LLM_MODEL=gpt-4o-mini

# ============================================================
# OpenAI-Compatible Remote Provider (provider-specific env vars)
# ============================================================
# When AURORA_LLM_PROVIDER=openai-compatible, these override the generic vars.
# API key is server-side only. Never exposed to frontend.
# AURORA_OPENAI_COMPATIBLE_BASE_URL=https://example.com/v1
# AURORA_OPENAI_COMPATIBLE_API_KEY=
# AURORA_OPENAI_COMPATIBLE_MODEL=model-name

# ============================================================
# Frontend (set in Vercel/hosting dashboard)
# ============================================================
# VITE_API_URL=https://your-backend-domain.com
